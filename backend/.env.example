# ——— MySQL（Docker 网络内通过服务名 mysql 访问）———
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpass
MYSQL_DATABASE=contract_review

# ——— Redis ———
REDIS_URL=redis://redis:6379/0

# ——— JWT ———
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ——— ChromaDB standalone（通过 HTTP 客户端连接）———
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ——— LLM（在线 API，通过 Provider 抽象层切换）———
# 可选值：doubao | qwen | openai
LLM_PROVIDER=doubao
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=doubao-pro-32k
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ——— Embedding（在线 API）———
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=doubao-embedding-large-text-250815
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ——— 文件存储 ———
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ——— 服务 ———
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
