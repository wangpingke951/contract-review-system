# ——— MySQL（Docker 网络内通过服务名 mysql 访问）———
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpass
MYSQL_DATABASE=contract_review

# ——— Redis ———
REDIS_URL=redis://redis:6379/0

# ——— JWT ———
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ——— ChromaDB standalone（通过 HTTP 客户端连接）———
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ——— LLM（在线 API，通过 Provider 抽象层切换）———
# 可选值：siliconflow | doubao | qwen | openai | mock
LLM_PROVIDER=siliconflow
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=https://api.siliconflow.cn/v1

# ——— 多模态（图片合同识别，PNG/JPG 上传时使用）———
# 图片不做本地 OCR，交给多模态模型转录。VISION_MODEL 必填；
# VISION_API_KEY / VISION_BASE_URL 留空则继承上面的 LLM_API_KEY / LLM_BASE_URL。
# 常见取值：doubao-vision-pro-32k / qwen-vl-plus / Qwen/Qwen2.5-VL-7B-Instruct / gpt-4o-mini
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VISION_API_KEY=
VISION_BASE_URL=

# ——— Embedding（在线 API）———
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=doubao-embedding-large-text-250815
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ——— 文件存储 ———
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ——— 服务 ———
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ——— 自助注册 ———
# 是否允许登录页自助注册普通用户；管理员账号始终不开放注册
ALLOW_REGISTER=true

# ——— 单端口部署：由 FastAPI 托管前端构建产物 ———
# true 时访问 http://<host>:8000 直接是前端页面，无需再起 vite / nginx。
# 前置：cd frontend && npm run build
SERVE_FRONTEND=false
